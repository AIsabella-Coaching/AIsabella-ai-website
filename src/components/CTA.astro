---
import { Image } from 'astro:assets';
import { calendlyUrl } from '../config/site';
import schreibtisch from '../assets/szenen/schreibtisch.jpg';
import bildschirm2 from '../assets/szenen/bildschirm-2.png';
import bildschirm3 from '../assets/szenen/bildschirm-3.png';
import bildschirm4 from '../assets/szenen/bildschirm-4.png';

// Bildschirm-Ausschnitte für die Überblendung: liegen exakt über dem
// Laptop-Bildschirm im Grundbild (Ausschnitt 222/640, 368×315 von 1122×1402 px).
const bildschirme = [bildschirm2, bildschirm3, bildschirm4];
---

<section id="erstgespraech" class="cta-section">

  <div class="cta-mobile-bg" aria-hidden="true"></div>
  <div class="cta-readability-overlay" aria-hidden="true"></div>

  <div class="cta-container">
    <!-- Szenenbild (KI-Bild, Oktober 2026): Isabella unscharf von hinten im
         Videogespräch. Auf dem Bildschirm wechseln langsam vier Menschen
         (Überblendung nur per CSS; bei „weniger Bewegung“ Standbild). -->
    <figure class="scene-photo cta-photo">
      <Image
        src={schreibtisch}
        alt="Blick über die Schulter von Isabella auf ihren Laptop, auf dem ein Videogespräch läuft"
        widths={[340, 510, 680, 1020]}
        sizes="(min-width: 900px) 340px, (max-width: 767px) calc(100vw - 48px), 420px"
        quality={80}
        loading="lazy"
      />
      {bildschirme.map((b, i) => (
        <Image
          src={b}
          alt=""
          aria-hidden="true"
          class={`cta-screen cta-screen-${i + 1}`}
          widths={[130, 200, 260, 370]}
          sizes="(min-width: 900px) 112px, 33vw"
          format="webp"
          quality={80}
          loading="lazy"
        />
      ))}
      <span class="scene-ai-label" title="KI-generiertes Bild"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.2 6.6L21 11l-6.8 2.4L12 20l-2.2-6.6L3 11l6.8-2.4z" /></svg><span aria-hidden="true">KI</span><span class="sr-only">KI-generiertes Bild</span></span>
    </figure>

    <div class="cta-text">
    <h2>Dein Erstgespräch</h2>

    <p class="cta-subline">
      20 Minuten, online, kostenfrei und vertraulich – ohne Verpflichtung. Wir klären, wo du mit KI gerade stehst, was dich beschäftigt und ob das Sparring zu deiner Situation passt. Du bekommst eine ehrliche Einschätzung von mir und danach entscheidest du in Ruhe, ob du weitergehen willst.
    </p>

    <a
      href={calendlyUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="cta-button inline-block text-white font-bold py-4 px-10 rounded-lg text-lg"
    >
      Erstgespräch vereinbaren
    </a>
    </div>
  </div>
</section>

<style>
  /* Desktop: kein background-color, keine Aurora-::before – #deep-glow
     (seitenweite Tapete via BaseLayout) trägt die Sektion. Sektion bleibt
     bewusst transparent. */
  .cta-section {
    position: relative;
    z-index: 1;
    padding: 120px 48px;
    overflow: hidden;
    text-align: center;
  }

  /* Verlaufstrich am unteren Sektions-Ende – letzter Trenner vor Footer. */
  .cta-section::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--section-divider);
    z-index: 3;
    pointer-events: none;
  }

  /* Mobile-Hintergrund-Layer. Auf Desktop display:none, damit das Bild
     gar nicht erst geladen wird. Auf Mobile (≤767 px) via Media-Query
     aktiviert – #deep-glow ist auf Mobile durch andere Mechanismen
     ausgeblendet, deshalb braucht die Sektion hier eine eigene Tapete. */
  .cta-mobile-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    display: none;
  }

  /* Lesbarkeits-Overlay: radialer Verlauf in --black-warm, zentriert auf
     den Text-Block. Ellipse (60 % horizontal, 70 % vertikal) dämpft die
     #deep-glow-Aurora im Text-Bereich, lässt sie an den Sektions-Rändern
     (oben/unten/links/rechts) voll sichtbar – keine horizontalen Kanten
     mehr wie bei einem Plateau-Verlauf. Peak im Zentrum 0.75 (deutlich
     über Hero 0.60), weil CTA als Schluss-Moment den Text-Kontrast
     stärker betont. Mobile-Overlay bleibt linear (Peak 0.45 über
     statischem Bild) – siehe Media-Query unten. */
  .cta-readability-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(
      ellipse 60% 70% at 50% 50%,
      rgba(16, 10, 30, 0.75) 0%,
      rgba(16, 10, 30, 0.55) 40%,
      rgba(16, 10, 30, 0.25) 70%,
      rgba(16, 10, 30, 0) 100%
    );
  }

  .cta-container {
    position: relative;
    z-index: 2;
    max-width: 720px;
    margin: 0 auto;
  }

  .cta-photo {
    width: 100%;
    max-width: 420px;
    margin: 0 auto 48px;
  }

  /* Bildschirm-Ausschnitte: Lage in Prozent des Grundbilds (1122×1402 px). */
  .cta-photo :global(.cta-screen) {
    position: absolute;
    left: 19.786%;
    top: 45.649%;
    width: 32.799%;
    height: auto;
    opacity: 0;
    animation: cta-screen-fade 8.5s linear infinite both;
  }
  .cta-photo :global(.cta-screen-1) { animation-delay: 2.5s; }
  .cta-photo :global(.cta-screen-2) { animation-delay: 4.5s; }
  .cta-photo :global(.cta-screen-3) { animation-delay: 6.5s; }

  /* Ablauf (8,5 s): erste Person (Grundbild) 2,5 s, danach die drei
     anderen je 2 s, dann wieder von vorne. Wechsel jeweils 0,5 s weich. */
  @keyframes cta-screen-fade {
    0%      { opacity: 0; }
    5.88%   { opacity: 1; }
    23.53%  { opacity: 1; }
    29.41%  { opacity: 0; }
    100%    { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-photo :global(.cta-screen) {
      animation: none;
      display: none;
    }
  }

  @media (min-width: 900px) {
    .cta-container {
      max-width: 1040px;
      display: grid;
      grid-template-columns: 340px 1fr;
      gap: 64px;
      align-items: center;
      text-align: left;
    }
    .cta-photo {
      max-width: none;
      margin: 0;
    }
  }

  .cta-section h2 {
    font-family: 'Geist', 'Inter', sans-serif;
    font-size: 38px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--white);
    margin: 0 0 28px 0;
  }

  .cta-subline {
    font-family: 'Geist', 'Inter', sans-serif;
    font-size: 17px;
    line-height: 1.75;
    color: var(--text-soft);
    margin: 0 0 40px 0;
  }

  @media (max-width: 767px) {
    .cta-section {
      padding: 80px 24px;
    }
    .cta-section h2 {
      font-size: 28px;
      /* Text-shadow analog zum Hero-H1 plus omnidirektionalem Halo –
         hebt die Headline vom Bild-Hintergrund klar ab. */
      text-shadow:
        0 0 24px rgba(0, 0, 0, 0.95),
        0 4px 16px rgba(0, 0, 0, 0.9),
        0 2px 4px rgba(0, 0, 0, 0.8);
    }
    .cta-subline {
      /* Volles Weiß statt --text-soft (rgba 0.82): Kontrast zum
         Bild-Hintergrund anheben. */
      color: var(--white);
      text-shadow:
        0 0 16px rgba(0, 0, 0, 0.95),
        0 2px 10px rgba(0, 0, 0, 0.9),
        0 1px 3px rgba(0, 0, 0, 0.8);
    }
    .cta-mobile-bg {
      display: block;
      background-image: url("/images/cta-bg-mobile.jpg");
      background-size: cover;
      background-position: center center;
      background-repeat: no-repeat;
    }
    .cta-readability-overlay {
      background: linear-gradient(
        to bottom,
        rgba(16, 10, 30, 0) 0%,
        rgba(16, 10, 30, 0.45) 20%,
        rgba(16, 10, 30, 0.45) 80%,
        rgba(16, 10, 30, 0) 100%
      );
    }
  }
</style>
