import UeberMich from '../components/UeberMich.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
---
<BaseLayout
  title="1:1 KI-Sparring für Unternehmer & Führungskräfte in Wien | AIsabella"
  description="KI als Denkpartner für strategische Fragen, Entscheidungen und alles, was tatsächlich Gewicht hat in deinem täglichen Geschäft."
>
  <main id="main-content" tabindex="-1">
  <Hero />
  <Sparring />
  <Beraterstab />
  <UeberMich />
  <Testimonials />
  <FAQ />
  <CTA />
  </main>
