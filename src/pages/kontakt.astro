---
import BaseLayout from '../layouts/BaseLayout.astro';
import { contactEndpoint } from '../config/site';
---
<BaseLayout
  title="Kontakt | AIsabella"
  description="Kontakt zu AIsabella – Strategisches KI-Sparring: Schreib Isabella Bogdanovic eine Nachricht."
  robots="noindex, follow"
  canonical="https://aisabella.ai/kontakt"
  legalPage
>
  <!-- Hero -->
  <section class="relative pt-20 pb-16 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-gray-900 via-purple-900/30 to-cyan-900/20"></div>
    <div class="container mx-auto px-6 text-center relative z-10">
      <h1 class="text-2xl sm:text-3xl font-extrabold text-white mb-3">Kontakt</h1>
      <p class="mt-4 text-lg text-gray-400">Schreib mir, worum es geht. Ich antworte dir per E-Mail.</p>
    </div>
  </section>

  <!-- Content -->
  <main id="main-content" tabindex="-1" class="py-10 md:py-16">
    <div class="container mx-auto px-6">
      <!-- Formular sendet erst beim Absenden an das Apps-Script-Projekt in Isabellas Google-Konto.
           Beim Seitenaufruf wird nichts von fremden Servern geladen (ADR-058). -->
      <form id="contact-form" data-endpoint={contactEndpoint} class="glass-card rounded-xl p-6 md:p-8 max-w-2xl mx-auto space-y-6">
        <div>
          <label for="contact-name" class="block text-base font-semibold text-white mb-2">Name <span class="font-normal text-gray-400">(freiwillig)</span></label>
          <input id="contact-name" name="name" type="text" autocomplete="name" maxlength="100" class="contact-field" />
        </div>
        <div>
          <label for="contact-email" class="block text-base font-semibold text-white mb-2">E-Mail-Adresse</label>
          <input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="200" class="contact-field" />
        </div>
        <div>
          <label for="contact-message" class="block text-base font-semibold text-white mb-2">Deine Nachricht</label>
          <textarea id="contact-message" name="nachricht" rows="6" required maxlength="5000" class="contact-field resize-y"></textarea>
        </div>

        <!-- Roboter-Falle: für Menschen unsichtbar und nicht erreichbar, Programme füllen es aus -->
        <div class="contact-trap" aria-hidden="true">
          <label for="contact-website">Website</label>
          <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <p class="text-sm text-gray-400">
          Deine Angaben verwende ich nur, um dir zu antworten. Mehr dazu in der <a href="/privacy#kontaktformular" class="underline text-cyan-400 hover:text-cyan-300">Datenschutzerklärung</a>.
        </p>

        <div>
          <button type="submit" class="cta-button w-full sm:w-auto text-white font-bold py-4 px-10 rounded-lg text-lg cursor-pointer disabled:opacity-60 disabled:cursor-wait">Nachricht senden</button>
        </div>

        <p id="contact-status" role="status" aria-live="polite" class="text-base empty:hidden"></p>
      </form>

      <p class="text-center text-base mt-8">
        Oder direkt per E-Mail: <a href="mailto:aisabella@aisabella.ai" class="text-cyan-400 hover:text-cyan-300">aisabella@aisabella.ai</a>
      </p>

      <div class="text-center pt-6">
        <a href="/" class="inline-block mt-2 text-sm underline hover:text-gray-200">Zurück zur Startseite</a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .contact-field {
    display: block;
    width: 100%;
    padding: 12px 16px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: var(--white);
    font: inherit;
    font-size: 16px; /* ab 16px zoomt iOS beim Antippen nicht in das Feld */
  }
  .contact-field:focus {
    border-color: var(--teal);
  }
  .contact-trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>

<script is:inline>
  (function () {
    const form = document.getElementById("contact-form");
    const status = document.getElementById("contact-status");
    if (!form || !status) return;
    const button = form.querySelector('button[type="submit"]');
    const startedAt = Date.now();
    // Letzter Teil jeder Meldung bricht nicht um (kein „E-“ am Zeilenende, kein Einzelwort)
    const fallback = ["Das hat leider nicht geklappt. Schreib mir bitte direkt an ", "aisabella@aisabella.ai."];
    const success = ["Danke, deine Nachricht ist angekommen. Ich melde mich per ", "E-Mail bei dir."];

    const show = ([text, tail], ok) => {
      const keep = document.createElement("span");
      keep.className = "whitespace-nowrap";
      keep.textContent = tail;
      status.replaceChildren(text, keep);
      status.classList.toggle("text-cyan-300", ok);
      status.classList.toggle("text-red-300", !ok);
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const endpoint = form.dataset.endpoint;
      if (!endpoint) { show(fallback, false); return; }

      const data = new FormData(form);
      const payload = {
        name: data.get("name") || "",
        email: data.get("email") || "",
        nachricht: data.get("nachricht") || "",
        website: data.get("website") || "",
        dauer: Date.now() - startedAt,
      };

      button.disabled = true;
      button.textContent = "Wird gesendet …";
      try {
        // text/plain: einfache Anfrage ohne Vorab-Prüfung, die Apps Script nicht beantworten könnte
        const response = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "text/plain;charset=utf-8" },
          body: JSON.stringify(payload),
        });
        const result = await response.json();
        if (!result.ok) throw new Error(result.grund || "fehler");
        form.reset();
        show(success, true);
      } catch {
        show(fallback, false);
      } finally {
        button.disabled = false;
        button.textContent = "Nachricht senden";
      }
    });
  })();
</script>
